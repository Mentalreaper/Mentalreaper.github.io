  "SYS_GUESS": {
    "10": "REM === NUMBER GUESSING GAME ===",
    "20": "HOME",
    "30": "N% = INT(RND(1) * 100) + 1",
    "40": "A% = 0",
    "50": "PRINT \"NUMBER GUESSING GAME\"",
    "60": "PRINT \"I'M THINKING OF A NUMBER\"",
    "70": "PRINT \"BETWEEN 1 AND 100\"",
    "80": "PRINT \"\"",
    "90": "INPUT \"YOUR GUESS: \";G%",
    "100": "A% = A% + 1",
    "110": "IF G% = N% THEN GOTO 150",
    "120": "IF G% < N% THEN PRINT \"TOO LOW! TRY AGAIN.\"",
    "130": "IF G% > N% THEN PRINT \"TOO HIGH! TRY AGAIN.\"",
    "140": "GOTO 90",
    "150": "PRINT \"\"",
    "160": "PRINT \"CORRECT! YOU GOT IT IN \";A%;\" TRIES!\"",
    "170": "PRINT \"\"",
    "180": "END"
